# Cabeçalhos do Cloudflare Pages (o build copia este arquivo para build/web).
# Quem decide a versão é o Service Worker: estes arquivos nunca podem ficar presos no cache HTTP.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(self), geolocation=()

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
