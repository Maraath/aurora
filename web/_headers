# Cabeçalhos do Cloudflare Pages (o build copia este arquivo para build/web).
# Quem decide a versão é o Service Worker: estes arquivos nunca podem ficar presos no cache HTTP.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(self), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://fhmhmdzbujqhkdsfnbtx.supabase.co; font-src 'self' data: https://fonts.gstatic.com https://www.gstatic.com; media-src 'self' data: blob:; connect-src 'self' https://fhmhmdzbujqhkdsfnbtx.supabase.co wss://fhmhmdzbujqhkdsfnbtx.supabase.co https://fonts.gstatic.com https://www.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/aurora_web.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
